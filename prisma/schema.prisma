generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  name                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  refreshToken          String?
  refreshTokenCreatedAt DateTime?
  role                  Role      @default(USER)
  notes                 Note[]
}

model Block {
  id            String    @id @default(uuid())
  type          BlockType
  content       String
  designId      Int
  colorOptionId Int
  title         String?
  order         Float
  noteId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publicId      String    @unique
  note          Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, order])
  @@index([noteId])
}

model Note {
  id          String   @id @default(uuid())
  title       String
  description String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blocks      Block[]
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

enum BlockType {
  block
  code
  image
  table
  divider
  formula
}

enum Role {
  USER
  ADMIN
}
