// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlockType {
  block
  code
  image
  table
  divider
  formula
}

//
// USER MODEL
//

enum Role {
  USER
  ADMIN
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?
  role     Role    @default(USER)

  refreshToken          String?
  refreshTokenCreatedAt DateTime?

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// BLOCK MODEL
//

model Block {
  id      String @id @default(uuid())
  publicId String @unique

  type    BlockType
  content String

  designId      Int
  colorOptionId Int

  title String?

  order Float

  // relation to Note (many-to-one)
  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([noteId, order])
  @@index([noteId])
}

//
// NOTE MODEL
//

model Note {
  id      String @id @default(uuid())
  publicId String @unique

  title       String
  description String?

  // author relation
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // blocks relation (one-to-many)
  blocks Block[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}
